{
  "name": "github-signals",
  "version": "0.2.1",
  "private": true,
  "description": "A terminal dashboard for GitHub team activity and repository health",
  "type": "module",
  "bin": {
    "github-signals": "./dist/src/cli.js"
  },
  "files": [
    ".github-signals.example.json",
    "AGENTS.md",
    "dist/src/**/*.js",
    "docs/ARCHITECTURE.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-build.js",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "test": "node --test 'dist/test/*.test.js'",
    "check": "npm run build && npm test",
    "hooks:install": "git config core.hooksPath .githooks",
    "package:release": "npm run check && node scripts/package-release.js",
    "verify:release-tag": "node scripts/verify-release-tag.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
